{
  "name": "pixfortech",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:seed": "node scripts/seed.mjs",
    "qa:app": "node scripts/app-qa.mjs",
    "qa:forge": "node scripts/forge-qa.mjs",
    "db:migrate": "tsx scripts/migrate-postgres.ts",
    "db:import-sqlite": "tsx scripts/migrate-postgres.ts --import-sqlite",
    "admin:bootstrap": "tsx scripts/admin-bootstrap.ts",
    "admin:check": "tsx scripts/admin-bootstrap.ts --check",
    "test:integration": "vitest run --config scripts/vitest.integration.config.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "@aws-sdk/s3-request-presigner": "3.1127.0",
    "@neondatabase/serverless": "1.1.0",
    "better-auth": "1.7.3",
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "0.45.2",
    "motion": "13.2.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "ws": "8.21.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/ws": "8.18.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
